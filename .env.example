# ============================================
# Projeto Soberana — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e ajuste conforme necessário.
# NÃO commite o .env no repositório (já está no .gitignore).

# --- Banco de Dados (PostgreSQL via Docker) ---
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://soberana:soberana_dev@localhost:5432/soberana_db?schema=public"

# --- Backend ---
BACKEND_PORT=3333
FRONTEND_URL="http://localhost:3001"

# --- Seed do Banco (usuário admin) ---
ADMIN_EMAIL="admin@soberana.com"
ADMIN_PASSWORD="defina-uma-senha-forte-aqui"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:3333/api"